# 서버 설정
CHAT_SERVICE_NAME=mmb-chat-service
SERVICE_PORT=8084

# 데이터베이스 설정 (MariaDB 기준)
DB_HOST=local-mysql
CONTAINER_DB_PORT=3306
DB_NAME=sample_db
DB_USERNAME=sample_user
DB_PASSWORD=sample_password

MONGO_HOST=mongo
MONGO_PORT=27017
REDIS_HOST=redis
REDIS_PORT=6380

# JPA 설정
JPA_DDL_AUTO=update         # 운영 환경에서는 validate 또는 none 권장
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# 로깅 설정
LOG_ROOT_LEVEL=info
LOG_WEB_LEVEL=debug
LOG_APP_LEVEL=debug         # com.demo 패키지 기준, 실제 패키지명에 맞게 조정 가능